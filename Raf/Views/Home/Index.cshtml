@{
    ViewData["Title"] = "Ana Sayfa";
}

<section class="p-4 p-md-5 mb-4 bg-body-tertiary rounded-3">
    <h1 class="display-5 fw-bold">Raf</h1>
    <p class="lead col-lg-8">
        İzlediğin filmleri, oynadığın oyunları ve dinlediğin albümleri tek bir rafta topla.
        Puanla, incele, listeler oluştur ve takip ettiklerinin neler izleyip dinlediğini gör.
    </p>
</section>

<div class="row g-3">
    <div class="col-12 col-md-4">
        <div class="card h-100">
            <div class="card-body">
                <h2 class="h5 card-title">Filmler</h2>
                <p class="card-text text-muted">TMDB üzerinden film ara, kütüphanene ekle ve puanla.</p>
            </div>
        </div>
    </div>
    <div class="col-12 col-md-4">
        <div class="card h-100">
            <div class="card-body">
                <h2 class="h5 card-title">Oyunlar</h2>
                <p class="card-text text-muted">RAWG üzerinden oyun ara, oynadıklarını kaydet ve incele.</p>
            </div>
        </div>
    </div>
    <div class="col-12 col-md-4">
        <div class="card h-100">
            <div class="card-body">
                <h2 class="h5 card-title">Albümler</h2>
                <p class="card-text text-muted">Discogs üzerinden albüm ara, dinlediklerini listelere ekle.</p>
            </div>
        </div>
    </div>
</div>
