@{
    ViewData["Title"] = "Ana Sayfa";
}

<section class="p-4 p-md-5 mb-4 bg-body-tertiary rounded-3">
    <h1 class="display-5 fw-bold">Raf</h1>
    <p class="lead col-lg-8">
        İzlediğin filmleri, oynadığın oyunları ve dinlediğin albümleri tek bir rafta topla.
        Puanla, incele, listeler oluştur ve takip ettiklerinin neler izleyip dinlediğini gör.
    </p>
    <a class="btn btn-primary btn-lg" asp-controller="Icerikler" asp-action="Index">Kütüphaneye göz at</a>
</section>

<div class="row g-3">
    <div class="col-12 col-md-4">
        <a class="card h-100 text-decoration-none icerik-kart" asp-controller="Icerikler" asp-action="Index" asp-route-tur="Film">
            <div class="card-body">
                <h2 class="h5 card-title text-body">Filmler</h2>
                <p class="card-text text-muted">İzlediğin filmleri kaydet, puanla ve incele.</p>
            </div>
        </a>
    </div>
    <div class="col-12 col-md-4">
        <a class="card h-100 text-decoration-none icerik-kart" asp-controller="Icerikler" asp-action="Index" asp-route-tur="Oyun">
            <div class="card-body">
                <h2 class="h5 card-title text-body">Oyunlar</h2>
                <p class="card-text text-muted">Oynadığın oyunları kaydet, puanla ve incele.</p>
            </div>
        </a>
    </div>
    <div class="col-12 col-md-4">
        <a class="card h-100 text-decoration-none icerik-kart" asp-controller="Icerikler" asp-action="Index" asp-route-tur="Album">
            <div class="card-body">
                <h2 class="h5 card-title text-body">Albümler</h2>
                <p class="card-text text-muted">Dinlediğin albümleri kaydet ve listelere ekle.</p>
            </div>
        </a>
    </div>
</div>
