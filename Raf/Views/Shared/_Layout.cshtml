<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Raf</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/Raf.styles.css" asp-append-version="true" />
</head>
<body class="d-flex flex-column min-vh-100">
    <header>
        <nav class="navbar navbar-expand-lg navbar-dark bg-dark mb-4">
            <div class="container">
                <a class="navbar-brand fw-bold" asp-area="" asp-controller="Home" asp-action="Index">Raf</a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#anaMenu"
                        aria-controls="anaMenu" aria-expanded="false" aria-label="Menüyü aç/kapat">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="collapse navbar-collapse" id="anaMenu">
                    <ul class="navbar-nav me-auto">
                        <li class="nav-item">
                            <a class="nav-link" asp-area="" asp-controller="Home" asp-action="Index">Ana Sayfa</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-area="" asp-controller="Icerikler" asp-action="Index" asp-route-tur="Film">Filmler</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-area="" asp-controller="Icerikler" asp-action="Index" asp-route-tur="Oyun">Oyunlar</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-area="" asp-controller="Icerikler" asp-action="Index" asp-route-tur="Album">Albümler</a>
                        </li>
                    </ul>
                    <div class="d-flex flex-wrap align-items-center gap-2 py-2 py-lg-0">
                        @if (User.IsInRole(Roller.Yonetici))
                        {
                            <a class="btn btn-outline-light btn-sm" asp-area="" asp-controller="IcerikEkle" asp-action="Index">İçerik Ekle</a>
                        }
                        @if (User.Identity?.IsAuthenticated == true)
                        {
                            <span class="navbar-text small">@User.Identity.Name</span>
                            <form asp-area="" asp-controller="Hesap" asp-action="Cikis" method="post" class="d-inline">
                                <button type="submit" class="btn btn-sm btn-outline-light">Çıkış</button>
                            </form>
                        }
                        else
                        {
                            <a class="btn btn-sm btn-outline-light" asp-area="" asp-controller="Hesap" asp-action="Giris">Giriş</a>
                            <a class="btn btn-primary btn-sm" asp-area="" asp-controller="Hesap" asp-action="Kayit">Kayıt Ol</a>
                        }
                    </div>
                </div>
            </div>
        </nav>
    </header>

    <main role="main" class="container flex-grow-1 pb-4">
        @if (TempData["Mesaj"] is string mesaj)
        {
            <div class="alert alert-success alert-dismissible fade show">
                @mesaj
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Kapat"></button>
            </div>
        }
        @if (TempData["Hata"] is string hata)
        {
            <div class="alert alert-danger alert-dismissible fade show">
                @hata
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Kapat"></button>
            </div>
        }
        @RenderBody()
    </main>

    <footer class="border-top py-3 text-muted small">
        <div class="container">
            &copy; 2026 Raf &middot; Film, oyun ve müzik kütüphanesi &middot;
            <a class="link-secondary" asp-area="" asp-controller="Home" asp-action="Privacy">Gizlilik</a>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
